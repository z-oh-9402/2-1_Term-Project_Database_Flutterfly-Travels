# Copy this file to .env and fill in the values.
PORT = 3000

# Database Configuration
DB_USERNAME = 'postgres'
DB_HOST = 'localhost'
DB_DATABASE = 'flutterfly_travels'
DB_PORT = 5432
DB_PASSWORD = ''

# Authentication
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET = ''
JWT_EXPIRES_IN = 1d

# Supabase Storage, for the photos users upload (profile and chat photos)
# The URL and key are in the Supabase dashboard: Project Settings > API. Keep the service role key secret.
# The bucket is one you create under Storage, marked Public.
SUPABASE_URL = ''
SUPABASE_SERVICE_ROLE_KEY = ''
SUPABASE_BUCKET = 'photos'
